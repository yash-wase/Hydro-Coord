# ─────────────────────────────────────────────────────────────
# HydroCoord Backend — Environment Variables
# Copy this file to .env for local dev.
# On Railway: set these in the service's Variables tab.
# ─────────────────────────────────────────────────────────────

# PORT is set automatically by Railway. Leave blank here.
PORT=4000

# ▼▼▼ PASTE YOUR RAILWAY PYTHON SERVICE URL HERE ▼▼▼
# After deploying python-service on Railway, copy its public URL
# (e.g. https://hydrocoord-python.up.railway.app) and paste below.
PYTHON_URL=https://YOUR_PYTHON_SERVICE.up.railway.app
